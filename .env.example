# Modelo de Variáveis de Ambiente com Objetivo de Tutorial (.env.example)
# Instruções: Copie este arquivo, renomeie para .env e insira suas chaves reais abaixo. 

# Chave da API do Pexels (Gratuito em: https://www.pexels.com/api/) 
PEXELS_API_KEY=sua_chave_pexels_aqui 

# Chave da API do Google Gemini (Gratuito em: https://ai.google.dev/) 
GEMINI_API_KEY=sua_chave_gemini_aqui